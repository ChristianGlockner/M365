# --- App ---
# Public URL of the Next.js app (Auth.js / redirects)
AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string

# --- Database (Docker Compose defaults) ---
DATABASE_URL=postgresql://m365:m365@localhost:5432/m365

# --- Optional Redis (uncomment service in docker-compose.yml) ---
# REDIS_URL=redis://localhost:6379

# --- Microsoft Entra ID (multi-tenant Mandant SSO) ---
# See docs/entra-app-registration.md
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Multi-tenant issuer (any organizational directory):
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0
# Optional: set to "true" after credentials are configured (client hint)
# NEXT_PUBLIC_ENTRA_CONFIGURED=true

# --- Future Azure Container Apps (not required locally) ---
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# APPLICATIONINSIGHTS_CONNECTION_STRING=
