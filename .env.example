# --- App ---
# Public URL of the Next.js app (Auth.js / redirects)
AUTH_URL=http://localhost:3000
# REQUIRED — no code fallback. Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- Database (Docker Compose defaults; optional for tenant UI preview) ---
# Tenant registration uses a file store under apps/web/.data when Postgres is unavailable.
DATABASE_URL=postgresql://m365:m365@localhost:5432/m365

# --- Optional Redis (uncomment service in docker-compose.yml) ---
# REDIS_URL=redis://localhost:6379

# --- Demo / DEV preview (ignored when Entra credentials are set) ---
# Both must be the string "true" to enable. When AUTH_MICROSOFT_ENTRA_ID_* are set,
# demo login and mock tenant connect are always disabled (real consent only).
ALLOW_DEMO_AUTH=false
ALLOW_DEMO_TENANT_CONNECT=false

# --- Microsoft Entra ID (multi-tenant Mandant SSO + in-app admin consent) ---
# See docs/entra-app-registration.md
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Multi-tenant issuer (any organizational directory):
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0

# Redirect URIs to register on the App Registration (Web):
# - {AUTH_URL}/api/auth/callback/microsoft-entra-id
# - {AUTH_URL}/api/tenants/consent/callback

# --- Future Azure Container Apps (not required locally) ---
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# APPLICATIONINSIGHTS_CONNECTION_STRING=
